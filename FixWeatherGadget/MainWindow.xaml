<Window x:Class="FixWeatherGadget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FixWeatherGadget"
        mc:Ignorable="d"
        Title="Fix weather gadget" Height="150" Width="400" ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Grid>
        <Button x:Name="btnFix" Content="Apply fix" Width="150" Height="40" Click="BtnFix_Click" FontFamily="Segoe UI" FontWeight="Bold"/>
        <TextBlock VerticalAlignment="Bottom" 
           FontFamily="Segoe UI"
           Margin="5" 
           Foreground="Black" 
           FontSize="12">
            <TextBlock.Effect>
                <DropShadowEffect Color="White" BlurRadius="10" ShadowDepth="0" Opacity="1" />
            </TextBlock.Effect>
            <Run Text="© 2026 Vistaaa | "/>
            <Hyperlink NavigateUri="https://github.com/imvistaaa" RequestNavigate="Hyperlink_RequestNavigate" Foreground="DarkBlue">
                <Run Text="GitHub"/>
            </Hyperlink>
        </TextBlock>
    </Grid>
</Window>
